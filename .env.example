# Copy to .env and fill in. Never commit .env.

# OpenRouter: use a key made just for this project, with a low credit limit set in the dashboard.
OPENROUTER_API_KEY=
# Optional overrides (defaults live in config.py; see ADR 0009).
# OPENROUTER_TIMEOUT_S=30
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_DIM=1024
# RERANK_MODEL=qwen/qwen3-reranker-8b
# GENERATION_MODEL=anthropic/claude-haiku-5.5
# VISION_MODEL=anthropic/claude-haiku-5.5
# Hidden reasoning per role (ADR 0015); off by default.
# VISION_REASONING=false
# GENERATION_REASONING=false
# Eval judge: must be a different model family from the generators, with a ZDR endpoint
# (ADRs 0011, 0014).
# JUDGE_MODEL=openai/gpt-6-luna
# Spending caps in USD (models/cost.py). Keep them below the key's own credit limit.
# INGEST_BUDGET_USD=3.0
# EVAL_BUDGET_USD=2.0

# --- Live API hardening (docs/governance/control-matrix.md C20, C26, C27) ---
# Browser origins allowed to call the API, comma-separated. Empty = no CORS. Intended:
# CORS_ALLOW_ORIGINS=https://tcbryan17.github.io
CORS_ALLOW_ORIGINS=
# Per-IP limits on /ask. In memory and per process: valid for a single instance only.
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=60
# /figures has its own, more generous limit. /health is never limited.
# FIGURES_RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the app. 0 = use the TCP peer and ignore X-Forwarded-For (which
# clients can forge). Behind one platform proxy set 1; see ratelimit.client_ip.
# TRUSTED_PROXY_HOPS=0
# Process-wide cap on live /ask spend per UTC day (USD). Keep it below the provider credit limit.
# DAILY_SPEND_CAP_USD=1.0
# Bearer token for GET /stats (counters only). Unset = /stats is disabled (404).
STATS_TOKEN=
# Question text is never logged (owner's decision, ADR 0021): logs carry only counts and latency.

# SEC EDGAR requires a real contact in the User-Agent (fair-access policy). Set your own.
# SEC_USER_AGENT=Your Name you@example.com

# Local Postgres from docker compose. These defaults are for local development only.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-only
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag-dev-only@localhost:5433/rag

# Used by DB tests and CI. The test fixtures create this database on the same server as DATABASE_URL.
TEST_DATABASE_URL=postgresql://rag:rag-dev-only@localhost:5433/rag_test
