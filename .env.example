# Copy to .env and fill in. Never commit .env.

# OpenRouter: use a key made just for this project, with a low credit limit set in the dashboard.
OPENROUTER_API_KEY=
# Optional overrides (defaults live in config.py; see ADR 0009).
# OPENROUTER_TIMEOUT_S=30
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_DIM=1024
# RERANK_MODEL=qwen/qwen3-reranker-8b
# GENERATION_MODEL=anthropic/claude-haiku-5.5
# VISION_MODEL=anthropic/claude-haiku-5.5
# Eval judge: must be a different model family from the generators, with a ZDR endpoint (ADR 0011).
# JUDGE_MODEL=
# Spending caps in USD (models/cost.py). Keep them below the key's own credit limit.
# INGEST_BUDGET_USD=3.0
# EVAL_BUDGET_USD=2.0

# SEC EDGAR requires a real contact in the User-Agent (fair-access policy). Set your own.
# SEC_USER_AGENT=Your Name you@example.com

# Local Postgres from docker compose. These defaults are for local development only.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-only
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag-dev-only@localhost:5433/rag

# Used by DB tests and CI. The test fixtures create this database on the same server as DATABASE_URL.
TEST_DATABASE_URL=postgresql://rag:rag-dev-only@localhost:5433/rag_test
